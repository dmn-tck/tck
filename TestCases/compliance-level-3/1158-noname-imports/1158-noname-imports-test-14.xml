<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Contributed to DMN TCK by StrayAlien -->
<testCases xmlns="http://www.omg.org/spec/DMN/20160719/testcase"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation=""
           xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <modelName>1158-noname-imports-14-A.dmn</modelName>

    <!--
    Model A contains decision001 and decision003. Model B contains decision002 and another decision003.
    These decisions are connected by hrefs as follows:
        - decision001 requires decision002 defined in model B.
        - decision002 requires decision003 defined in model B.
    (see section 13.3.2 References within the DMN XSD)

    Based of the above href links we expect the execution of decision001 in model A to return the value of
    decision003 defined in model B.
    -->

    <testCase id="001">
        <resultNode name="decision001" type="decision">
            <expected>
                <value xsi:type="xsd:string">model_b_decision003</value>
            </expected>
        </resultNode>
    </testCase>


</testCases>
